# AutoTrader AI - example environment. Dummy values only. PAPER-ONLY system.
#
# There is intentionally NO setting for wallet keys, private keys, API agents
# or a live trading mode. The app refuses to start if such variables exist.

# Only "PAPER" is accepted. Any other value aborts startup.
AUTOTRADER_TRADING_MODE=PAPER

# Local development database (docker compose). Change the password for any shared env.
POSTGRES_USER=autotrader
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=autotrader
# Owner URL: migrations and local CLI only. Services use the least-privilege users below.
AUTOTRADER_DATABASE_URL=postgresql+psycopg://autotrader:change-me-local-only@localhost:5432/autotrader
# Passwords for the least-privilege DB users (created on first DB start):
#   autotrader_api (read-only API) and autotrader_worker (market-data collector).
AUTOTRADER_API_DB_PASSWORD=api-local-only
AUTOTRADER_WORKER_DB_PASSWORD=worker-local-only
# Destructive integration tests run ONLY against a database whose name ends in _test:
# AUTOTRADER_TEST_DATABASE_URL=postgresql+psycopg://autotrader:change-me-local-only@localhost:5432/autotrader_test

AUTOTRADER_MARKET_DEX=xyz
AUTOTRADER_MARKET_COIN=xyz:CL
AUTOTRADER_INITIAL_EQUITY_USDC=1000
AUTOTRADER_MAX_ORACLE_MARK_DIVERGENCE_BPS=50
AUTOTRADER_LOG_LEVEL=INFO
AUTOTRADER_CORS_ORIGINS=http://localhost:3000

# Frontend -> backend (server-side fetch from Next.js)
API_BASE_URL=http://localhost:8000
