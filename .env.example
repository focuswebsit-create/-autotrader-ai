# AutoTrader AI - example environment. Dummy values only. PAPER-ONLY system.
#
# There is intentionally NO setting for wallet keys, private keys, API agents
# or a live trading mode. The app refuses to start if such variables exist.

# Only "PAPER" is accepted. Any other value aborts startup.
AUTOTRADER_TRADING_MODE=PAPER

# Local development database (docker compose). Change the password for any shared env.
POSTGRES_USER=autotrader
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=autotrader
# Owner URL: migrations and local CLI only. Services use the least-privilege users below.
AUTOTRADER_DATABASE_URL=postgresql+psycopg://autotrader:change-me-local-only@localhost:5432/autotrader
# Passwords for the least-privilege DB users (created on first DB start):
#   autotrader_api (read-only API) and autotrader_worker (market-data collector).
AUTOTRADER_API_DB_PASSWORD=api-local-only
AUTOTRADER_WORKER_DB_PASSWORD=worker-local-only
#   autotrader_control (Phase 3 Control API: start/stop commands, logins).
AUTOTRADER_CONTROL_DB_PASSWORD=control-local-only
#   autotrader_paper (Phase 3 paper-trader: the only user that may write PAPER fills).
AUTOTRADER_PAPER_DB_PASSWORD=paper-local-only

# --- Phase 3 Control API (owner login for the PAPER bot) ---
# HMAC key for CSRF tokens. REQUIRED. >= 32 random characters; generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (do not use a 64-character hex string: the safety check rejects wallet-key-like values)
# The service refuses to start while this still contains "change-me".
AUTOTRADER_CONTROL_SECRET=change-me-generate-a-random-48-char-value
# Session cookie "Secure" flag. Keep true behind HTTPS (production). Only for plain-HTTP
# local development set it to false.
AUTOTRADER_COOKIE_SECURE=false
# Browser origins allowed to send control requests (the URL you open the terminal on).
AUTOTRADER_PUBLIC_ORIGINS=http://localhost:3000
# 1 only when a reverse proxy you run (Caddy / Tailscale Serve) is the only way to reach
# the web server: then its X-Forwarded-For is used for the per-client login limits.
TRUST_PROXY_XFF=0
# Owner account (needs the DB owner role, so run it from the migrate image):
#   docker compose run --rm migrate autotrader user create --username owner --role ADMIN
# Destructive integration tests run ONLY against a database whose name ends in _test:
# AUTOTRADER_TEST_DATABASE_URL=postgresql+psycopg://autotrader:change-me-local-only@localhost:5432/autotrader_test

AUTOTRADER_MARKET_DEX=xyz
AUTOTRADER_MARKET_COIN=xyz:CL
AUTOTRADER_INITIAL_EQUITY_USDC=1000
AUTOTRADER_MAX_ORACLE_MARK_DIVERGENCE_BPS=50
AUTOTRADER_LOG_LEVEL=INFO
AUTOTRADER_CORS_ORIGINS=http://localhost:3000

# Frontend -> backend (server-side fetch from Next.js)
API_BASE_URL=http://localhost:8000

# --- Production (docker-compose.prod.yml, see docs/DEPLOYMENT.md) ---
# Dead-man's-switch URL from your monitoring service (e.g. https://hc-ping.com/<uuid>).
# Empty = no external alerts.
HEALTHCHECK_PING_URL=
# Nightly backups: directory on the host, retention and hour (UTC).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
BACKUP_HOUR_UTC=3
# Commit recorded with forward tests (set to: git rev-parse HEAD).
AUTOTRADER_GIT_SHA=unknown
